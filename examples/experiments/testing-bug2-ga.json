{
  "schema": "robosbse.experiment/1",
  "name": "testing-bug2-ga",
  "description": "GA guided by collision robustness searches for BUG-2 (braking distance omitted). Random testing does not find this bug within 2000 scenarios.",
  "seed": 3,
  "budget": {
    "maxEvaluations": 2000
  },
  "problem": {
    "type": "controller-testing",
    "map": "builtin:testing-arena",
    "params": {
      "controller": "reactive-bug2-braking",
      "properties": "safety",
      "fitness": "collision",
      "obstacleSlots": 4,
      "maxSteps": 1200,
      "simulationSeed": 1
    }
  },
  "algorithm": {
    "type": "genetic-algorithm",
    "params": {
      "populationSize": 50,
      "crossover": "one-point",
      "mutationSigma": 0.1,
      "elitism": 2
    }
  },
  "options": {
    "minimizeFailures": true,
    "maxFailureRecords": 5
  }
}