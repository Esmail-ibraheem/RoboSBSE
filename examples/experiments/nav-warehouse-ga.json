{
  "schema": "robosbse.experiment/1",
  "name": "nav-warehouse-ga",
  "description": "Route optimisation on the warehouse map with a genetic algorithm (travel-time objective).",
  "seed": 42,
  "budget": { "maxEvaluations": 2000 },
  "problem": {
    "type": "navigation",
    "map": "builtin:warehouse",
    "params": { "waypoints": 5, "controller": "waypoint-follower", "objective": "time", "maxSteps": 2400, "repair": true }
  },
  "algorithm": {
    "type": "genetic-algorithm",
    "params": { "populationSize": 40, "selection": "tournament", "tournamentSize": 3, "crossover": "one-point",
                "crossoverRate": 0.8, "mutation": "gaussian", "mutationSigma": 0.1, "elitism": 2 }
  }
}
