{
  "schema": "robosbse.experiment/1",
  "name": "testing-correct-ga",
  "description": "Control experiment: the same search on the correct reactive controller. No safety violation is expected.",
  "seed": 11,
  "budget": {
    "maxEvaluations": 3000
  },
  "problem": {
    "type": "controller-testing",
    "map": "builtin:testing-arena",
    "params": {
      "controller": "reactive",
      "properties": "safety",
      "fitness": "collision",
      "obstacleSlots": 4,
      "maxSteps": 1200,
      "simulationSeed": 1
    }
  },
  "algorithm": {
    "type": "genetic-algorithm",
    "params": {
      "populationSize": 30,
      "crossover": "uniform",
      "mutationSigma": 0.15,
      "elitism": 2
    }
  },
  "options": {
    "minimizeFailures": true,
    "maxFailureRecords": 5
  }
}