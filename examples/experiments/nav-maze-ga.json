{
  "schema": "robosbse.experiment/1",
  "name": "nav-maze-ga",
  "description": "GA on the deceptive maze with 10 waypoints and the pure-pursuit controller. Hard: compare with the A* reference.",
  "seed": 42,
  "budget": {
    "maxEvaluations": 6000
  },
  "problem": {
