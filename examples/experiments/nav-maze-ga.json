      "controller": "pure-pursuit",
      "objective": "time",
      "maxSteps": 2400,
      "repair": true
    }
  },
  "algorithm": {
    "type": "genetic-algorithm",
    "params": {
      "populationSize": 60,
      "crossover": "one-point",
      "mutationSigma": 0.08,
      "elitism": 3
    }
  }
}