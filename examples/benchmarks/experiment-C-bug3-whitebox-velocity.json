{
  "schema": "robosbse.benchmark/1",
  "name": "experiment-C-bug3-whitebox-velocity",
  "description": "Experiment C, BUG-3 with a rare trigger (initial battery >= 0.2), oracle restricted to BUG-3's expected property (velocity), so neither guidance is masked by the robustness of other properties. Random testing, GA guided by velocity robustness (black-box), GA guided by approach level + branch distance to low-battery-boost:true and then by velocity robustness (white-box).",
  "runs": 15,
  "baseSeed": 500,
  "threads": 8,
  "budget": {
    "maxEvaluations": 3000
  },
  "problem": {
    "type": "controller-testing",
    "map": "builtin:testing-arena",
    "params": {
      "controller": "reactive-bug3-boost",
      "properties": "velocity",
      "fitness": "velocity",
      "minBattery": 0.2
    }
  },
  "algorithms": [
    {
      "type": "random-search",
      "label": "Random Testing"
    },
    {
      "type": "genetic-algorithm",
      "label": "GA, velocity robustness (black-box)",
      "params": {
        "populationSize": 30
      }
    },
    {
      "type": "genetic-algorithm",
      "label": "GA, branch distance (white-box)",
      "params": {
        "populationSize": 30
      },
      "problemParams": {
        "fitness": "branch:low-battery-boost:true"
      }
    }
  ],
  "options": {
    "minimizeFailures": true,
    "archiveSize": 0
  },
  "describeFailures": true,
  "compareBy": "timeToTarget",
  "reference": false
}
