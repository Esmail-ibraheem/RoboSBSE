  "id": "rb1-stopping-distance",
  "name": "RB1: Incorrect stopping-distance threshold",
  "purpose": "program-repair",
  "defectKind": "Incorrect stopping-distance threshold",
  "defect": "The braking term of the speed limiter divides by 200 instead of 2 times the deceleration, so the controller believes it can stop in a hundredth of the real braking distance and drives into obstacles at speed.",
  "className": "subjects.StoppingDistanceBug",
  "source": "src/subjects/StoppingDistanceBug.java",
  "scope": [],
  "referenceFix": {
    "find": "v * v / (200.0 * deceleration)",
    "replace": "v * v / (2.0 * deceleration)"
  },
